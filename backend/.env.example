# Copy to backend/.env and adjust.
DATABASE_URL=postgresql+asyncpg://aichat:aichat@localhost:5433/aichat
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# The website's address (must match the frontend port)
CORS_ORIGINS=["http://localhost:3002"]
# Hosts allowed to call the MCP endpoint (/mcp). Add your server name to accept remote AIs, or ["*"] for any.
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]
# Attachments. Max size per file in MB (0 = no limit).
MAX_ATTACHMENT_MB=0
# Cloudflare R2 storage for attachments. Leave empty to store files on disk (backend/uploads/attachments).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
